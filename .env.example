# Environment variables the app needs. Real values live in Vercel (provisioned by the
# Neon, Clerk, and Upstash marketplace integrations) and are pulled locally with
# `vercel env pull .env.local --yes`. Never commit .env.local.

# Neon Postgres
DATABASE_URL=

# Clerk auth
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SIGNING_SECRET=

# Upstash Redis (rate limiting)
KV_REST_API_URL=
KV_REST_API_TOKEN=
